# Database connection
# SQLite (local dev):
# DATABASE_URL=sqlite:///./planbar.db
# PostgreSQL (Docker Compose):
DATABASE_URL=postgresql://planbar:change_me@localhost:5432/planbar_backend

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=replace_this_with_a_secure_value

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TiTO Integration
TITO_API_URL=http://localhost:5001
BACKEND_CALLBACK_URL=http://localhost:8000
TITO_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# CORS allowed methods and headers (comma-separated)
# Only override if your frontend uses non-standard methods/headers
# CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept

# Environment (development, test, staging, production, demo)
# - development/test: cookies secure=False (HTTP OK)
# - staging/production/demo: cookies secure=True (HTTPS required)
ENVIRONMENT=development

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone (default: UTC, e.g. Europe/Berlin)
# TIMEZONE=UTC
