# Database connection
# SQLite (local dev):
# DATABASE_URL=sqlite:///./planbar.db
# PostgreSQL (Docker Compose):
DATABASE_URL=postgresql://planbar:change_me@localhost:5432/planbar_backend

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=replace_this_with_a_secure_value

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TiTO Integration
TITO_API_URL=http://localhost:5001
BACKEND_CALLBACK_URL=http://localhost:8000
TITO_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (development, test, staging, production, demo)
ENVIRONMENT=development

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone (default: UTC, e.g. Europe/Berlin)
# TIMEZONE=UTC

# Security: Public self-registration for POST /api/v1/users
# Default (production): false — only admins can create accounts via /api/v1/users/admin-create
# Set to true ONLY in dev/test/invite-only onboarding flows.
# ENABLE_SELF_REGISTRATION=false

# ── ArbZG / TiTO solver parameters (sent to the TiTO job config section) ──
# Defaults follow the ArbZG (see src/app/services/arbzg_rules.py); only
# override if your deployment legally requires different values.
# MIN_REST_TIME_HOURS=11            # § 5 ArbZG
# MAX_DAILY_WORK_HOURS=10           # § 3 ArbZG
# MAX_CONSECUTIVE_DAYS=6            # § 3 + § 9 ArbZG
# MIN_FREE_SUNDAYS_PER_YEAR=15      # § 9 ArbZG
# NIGHT_WINDOW_START=23:00          # § 6 ArbZG
# NIGHT_WINDOW_END=06:00            # § 6 ArbZG
# NIGHT_WORK_MAX_HOURS=10           # § 6 ArbZG
# REST_TIME_SHIFT_WORKERS_HOURS=    # § 5 Abs. 2a (empty = unused)
# MAX_WEEKLY_HOURS_LAW=48           # § 3 S. 2 ArbZG

# German federal state for state-specific public holidays (§ 9 ArbZG),
# e.g. BW, BY, BE. Empty = nationwide holidays only.
# GERMAN_STATE=
