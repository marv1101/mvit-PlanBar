# Per-customer environment variables
# These are auto-generated by deploy-customer.sh.
# For manual setup, fill in secure values:

# Timezone for all services (e.g. Europe/Berlin)
TZ=Europe/Berlin

# Ports
FRONTEND_PORT=8081
TITO_PORT=5001
BACKEND_PORT=8001

# Domain
DOMAIN=kunde1.app.planbar.de

# Database names
PLANBAR_DB_NAME=kunde1_planbar
TITO_DB_NAME=kunde1_tito

# Secrets (generate with openssl rand -hex 32)
PLANBAR_DB_PASSWORD=<generate-with: openssl rand -hex 32>
TITO_DB_PASSWORD=<generate-with: openssl rand -hex 32>
SECRET_KEY=<generate-with: openssl rand -hex 32>
TITO_API_KEY=<generate-with: openssl rand -hex 16>
TITO_WORKER_API_KEY=<generate-with: openssl rand -hex 16>
TITO_JWT_SECRET=<generate-with: openssl rand -hex 32>

# Environment (production enables HTTPS-only cookies)
ENVIRONMENT=production
